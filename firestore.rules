rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    function member() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function roleMatchesIndex(attendanceId) {
      return (member().role == 'sm' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u0$'))
        || (member().role == 'po' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u1$'))
        || (member().role == 'fe' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u2$'))
        || (member().role == 'be' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u3$'))
        || (member().role == 'qa' && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u4$'));
    }

    function validMark() {
      return request.resource.data.keys().hasOnly([
          'v', 't', 'by', 'role', 'uid', 'updatedAt'
        ])
        && request.resource.data.v in [0, 1]
        && request.resource.data.t is string
        && request.resource.data.by == member().name
        && request.resource.data.role == member().role
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validAttendance(attendanceId) {
      return request.resource.data.keys().hasOnly([
          'd', 'p', 'r', 't', 'at', 'uid', 'createdAt'
        ])
        && request.resource.data.d is string
        && request.resource.data.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && attendanceId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_u[0-9]+$')
        && roleMatchesIndex(attendanceId)
        && attendanceId.split('_u')[0] == request.resource.data.d
        && request.resource.data.p == member().name
        && request.resource.data.r == member().displayRole
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is string
        && request.resource.data.at is string
        && request.resource.data.createdAt == request.time;
    }

    match /members/{uid} {
      allow read: if isActiveMember() && request.auth.uid == uid;
      allow write: if false;
    }

    match /marks/{markId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && validMark();
      allow delete: if isActiveMember();
    }

    match /asist/{attendanceId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && validAttendance(attendanceId);
      allow update, delete: if false;
    }
  }
}
